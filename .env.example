# Copy to .env and adjust. Every variable is optional; unset values fall back
# to the defaults noted below.

# update_antigravity.sh: Antigravity desktop install dir (default: $HOME/.local/opt/antigravity)
ANTIGRAVITY_OPT_DIR=$HOME/.local/opt/antigravity
# update_antigravity.sh: where old versions are moved (default: $HOME/TheWorkshop/_Temp_Trash)
TRASH_DIR=$HOME/TheWorkshop/_Temp_Trash
# update_antigravity.sh: backup directory (default: $HOME/TheWorkshop/Backups)
BACKUP_DIR=$HOME/TheWorkshop/Backups
# update_antigravity.sh: Antigravity CLI binary (default: $HOME/.local/bin/agy)
AGY_BIN=$HOME/.local/bin/agy

# headset-restart: substring of the sound card name to match (default: Turtle_Beach)
HEADSET_CARD_MATCH=Turtle_Beach
# headset-restart: log file (default: $HOME/TheWorkshop/Logs/headset-restart.log)
HEADSET_LOG=$HOME/TheWorkshop/Logs/headset-restart.log

# healthcheck.sh: space-separated local mount points to report (default: /)
HEALTHCHECK_LOCAL_MOUNTS="/ /run/media/youruser/DriveA /run/media/youruser/DriveB"
# healthcheck.sh: space-separated network share mount points (default: none)
HEALTHCHECK_NETWORK_MOUNTS="/mnt/share1 /mnt/share2"
# healthcheck.sh: space-separated BTRFS mount points to check for device errors (default: none)
HEALTHCHECK_BTRFS_MOUNTS="/run/media/youruser/DriveB"
# healthcheck.sh: network interface used for the LAN IP (default: eno1)
HEALTHCHECK_LAN_IFACE=eno1

# --- Server scripts: Aegis/, VpnHeartbeat/, ArchiveBackup/ (REQUIRED, no defaults) ---
# VpnHeartbeat/vpn_heartbeat.sh: Uptime Kuma push URL (single-quote it, it contains & and ?)
KUMA_PUSH_URL='http://<kuma-host>:<port>/api/push/<token>?status=up&msg=<name>&ping='
# VpnHeartbeat/vpn_heartbeat.sh: runtime state dir; vpn_status.json is written to $STATE_DIR/logs
STATE_DIR=/path/to/script_state
# ArchiveBackup/archive_backup.sh: log file, BTRFS vault mount (Backups/ must be a subvolume),
# and the source trees it mirrors
BACKUP_LOG_FILE=/path/to/backup.log
BACKUP_VAULT_MOUNT=/media/<vault>
APPDATA_DIR=/path/to/AppData
HEIMR_DIR=/path/to/projects-root
# ArchiveBackup: space-separated Postgres containers to pg_dumpall (optional)
BACKUP_PG_CONTAINERS='postgres other-db'
# ArchiveBackup: days of daily read-only snapshots to keep (default: 30)
BACKUP_SNAPSHOT_KEEP_DAYS=30
# ArchiveBackup: Uptime Kuma push URL, called only when a run passes (optional)
BACKUP_KUMA_PUSH_URL='http://<kuma-host>:<port>/api/push/<token>?status=up&msg=OK&ping='
# Aegis/aegis-sentinel.sh: UUID and mount point of the external media drive it waits for
MEDIA_DRIVE_UUID=<uuid from /dev/disk/by-uuid>
MEDIA_DRIVE_MOUNT=/media/<media-drive>
# Aegis/aegis-siege.sh: second drive unmounted on power loss
SECONDARY_DRIVE_MOUNT=/media/<second-drive>
# Aegis/install-aegis.sh: folder holding the saved NUT configs to deploy
NUT_MIGRATION_DIR=/path/to/host_configs/nut
